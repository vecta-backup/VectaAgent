FROM debian:12-slim

RUN apt-get update && apt-get install -y \
    python3 \
    python3-venv \
    python3-pip \
    binutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Install deps once; source is mounted at runtime
COPY requirements.txt .
RUN pip install --break-system-packages -r requirements.txt pyinstaller

# Default: drop into a shell (run ./build.sh manually, or override CMD)
CMD ["bash"]
